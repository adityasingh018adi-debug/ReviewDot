{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/app/products/[productId]",
      "regex": "^/app/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPproductId": "nxtPproductId"
      },
      "namedRegex": "^/app/products/(?<nxtPproductId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/r/[code]",
      "regex": "^/r/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/r/(?<nxtPcode>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/app",
      "regex": "^/app(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app(?:/)?$"
    },
    {
      "page": "/app/analytics",
      "regex": "^/app/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/analytics(?:/)?$"
    },
    {
      "page": "/app/campaigns",
      "regex": "^/app/campaigns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/campaigns(?:/)?$"
    },
    {
      "page": "/app/customers",
      "regex": "^/app/customers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/customers(?:/)?$"
    },
    {
      "page": "/app/feedback",
      "regex": "^/app/feedback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/feedback(?:/)?$"
    },
    {
      "page": "/app/inbox",
      "regex": "^/app/inbox(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/inbox(?:/)?$"
    },
    {
      "page": "/app/insights",
      "regex": "^/app/insights(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/insights(?:/)?$"
    },
    {
      "page": "/app/outlets",
      "regex": "^/app/outlets(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/outlets(?:/)?$"
    },
    {
      "page": "/app/products",
      "regex": "^/app/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/products(?:/)?$"
    },
    {
      "page": "/app/settings",
      "regex": "^/app/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/app/settings(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/pricing",
      "regex": "^/pricing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pricing(?:/)?$"
    },
    {
      "page": "/product",
      "regex": "^/product(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/product(?:/)?$"
    },
    {
      "page": "/resources",
      "regex": "^/resources(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/resources(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/solutions",
      "regex": "^/solutions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/solutions(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}
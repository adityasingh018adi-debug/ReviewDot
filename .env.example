# ReviewDot — environment
#
# Copy to .env.local and fill in. Anything prefixed NEXT_PUBLIC_ is visible in
# the browser; everything else must stay server-side.

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security — never expose to the client,
# never commit, never read from a component.
SUPABASE_SERVICE_ROLE_KEY=
# Direct connection string, used for migrations and the RLS test suite.
DATABASE_URL=

# --- AI -----------------------------------------------------------------
# Server only. Used by the review writer and response assistant API routes.
# Without it the app falls back to the deterministic local adapter.
ANTHROPIC_API_KEY=

# --- App ----------------------------------------------------------------
# Public origin. Used to build QR scan URLs and, importantly, the OAuth and
# password-reset redirect targets — so it must match the deployed origin exactly
# or Supabase will refuse the round trip.
NEXT_PUBLIC_SITE_URL=https://reviewdot.in

# --- Privacy ------------------------------------------------------------
# Server only. Keys the anonymous visitor hash stored on each scan, so a
# business can count unique visitors rather than raw scans. The hash is
# HMAC(secret + UTC date, ip + user agent): the address and user agent are
# inputs and are never stored, and the daily rotation means a device cannot be
# followed from one day to the next.
#
# Without it, scans are still recorded but visitor_hash stays null and
# unique-visitor counts are unavailable. Any long random string will do; keep it
# stable, because changing it resets those counts.
VISITOR_SALT=

# --- Mode ---------------------------------------------------------------
# Runs the dashboard on the seeded demo dataset with no database and no
# accounts. Set it to 1 deliberately or not at all: leaving it unset does NOT
# open the dashboard, it makes the app refuse to render one. Ignored entirely
# when Supabase is configured above — a real database always wins.
#
# NEXT_PUBLIC_* values are inlined at build time, so this has to be set for the
# build, not just for `next start`.
NEXT_PUBLIC_DEMO_MODE=
